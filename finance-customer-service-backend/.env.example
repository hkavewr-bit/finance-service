# 金融小二客服后端环境配置模板
# 复制为 .env 后填入真实值：cp .env.example .env

# === LLM ===
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.openai-proxy.org/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === 数据中台（finance-data）地址 ===
FINANCE_API_BASE_URL=http://127.0.0.1:8000

# === MySQL 持久化（dialogue_record 状态表，库 jinrong）===
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@192.168.100.100:3306/jinrong?charset=utf8mb4

# === 服务监听 ===
APP_HOST=0.0.0.0
APP_PORT=18082

# === 数据中台鉴权与演示身份（可省略，使用默认值）===
CHANNEL_CODE=MOBILE_BANK
OPERATOR_NO=EMP000006
DEMO_CUSTOMER_NO=CUS00000001
